NODE_ENV="test"
RELEASE=false
DEBUG=true
TEST=true
CI=true
DOMAIN=localhost
FRONTEND_HOST=localhost
FRONTEND_PORT=3000
BACKEND_HOST=localhost
BACKEND_PORT=8000

# SSR API URL - used by frontend during server-side rendering
# Default: http://backend:8000/api (Docker Compose service name)
SSR_API_URL=http://backend:8000/api

# Discord
DFLOGO_EMOJI_ID=1487856830364258304

# dota_lobby integration (backend/lobby). Test stacks talk to the simulated
# dota_lobby in docker-compose.test.yaml (service `dota-lobby`, profile
# `dota-lobby`). This file wins over backend/.env. Every value below is a
# test-only fixture shared with docker/dota-lobby/simulator-secrets.yaml,
# never a real credential. Without the dota-lobby service running, lobbies
# are on but nothing answers: only the 18-dota-lobby specs need it, and they
# skip.
DOTA_LOBBY_ENABLED=true
DOTA_LOBBY_URL=http://dota-lobby:8080
DOTA_LOBBY_API_KEY=df-test-dota-lobby-api-key
DOTA_LOBBY_WEBHOOK_SECRET=df-test-dota-lobby-webhook-secret
DOTA_LOBBY_TIMEOUT_SECONDS=5
# The simulator sends it with every webhook (X-Internal-Token); the celery
# workers send it to the internal API. Test stacks use this value, not the
# one in backend/.env.
INTERNAL_SERVICE_TOKEN=df-test-internal-service-token

# Telemetry
LOG_FORMAT=json
LOG_LEVEL=DEBUG
OTEL_ENABLED=false
