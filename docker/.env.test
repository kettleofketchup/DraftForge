NODE_ENV="test"
RELEASE=false
DEBUG=true
TEST=true
CI=true
DOMAIN=localhost
FRONTEND_HOST=localhost
FRONTEND_PORT=3000
BACKEND_HOST=localhost
BACKEND_PORT=8000

# SSR API URL - used by frontend during server-side rendering
# Default: http://backend:8000/api (Docker Compose service name)
SSR_API_URL=http://backend:8000/api

# Discord
DFLOGO_EMOJI_ID=1487856830364258304

# dota_lobby integration (backend/lobby), off by default. Turn it on here:
# this file wins over backend/.env. DOTA_LOBBY_URL, DOTA_LOBBY_API_KEY and
# DOTA_LOBBY_WEBHOOK_SECRET go in backend/.env; the other DOTA_LOBBY_*
# settings have defaults (backend/config/dota_lobby.py).
DOTA_LOBBY_ENABLED=false

# Telemetry
LOG_FORMAT=json
LOG_LEVEL=DEBUG
OTEL_ENABLED=false
