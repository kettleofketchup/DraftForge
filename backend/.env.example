discord_secret=
client_id=
discord_token=
STEAM_API_KEY=

# Discord Bot
DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_ADMIN_CHANNEL_ID=your_channel_id_here

# Discord Test Bots (for multi-user integration tests)
# Create bot apps at https://discord.com/developers/applications
# Invite to test server with permissions=66624 (View Channels + Read History + Add Reactions)
DISCORD_TEST_BOT_2_TOKEN=
DISCORD_TEST_BOT_3_TOKEN=

# =============================================================================
# Telemetry Configuration
# =============================================================================

# Master switch for telemetry (default: true for logging)
TELEMETRY_ENABLED=true

# Logging configuration
LOG_LEVEL=INFO
LOG_FORMAT=pretty  # 'pretty' for dev, 'json' for prod

# OpenTelemetry (disabled by default - enable when collector available)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=dtx-backend
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-us-central-0.grafana.net/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64-encoded-credentials>
# OTEL_TRACES_SAMPLER_ARG=0.1
