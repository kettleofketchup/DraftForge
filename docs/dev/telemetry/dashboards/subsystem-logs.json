        "sort": 0,
        "type": "query"
      },
      {
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "datasource": {
          "type": "loki",
          "uid": "${DS_LOKI}"
        },
        "definition": "label_values({deployment_environment=\"$env\"}, service_name)",
        "hide": 0,
        "includeAll": true,
        "label": "Service",
        "multi": true,
        "name": "service",
        "options": [],
        "query": {
          "label": "service_name",
          "refId": "LokiVariableQueryEditor-VariableQuery",
          "stream": "{deployment_environment=\"$env\"}",
          "type": 1
        },
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      },
      {
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "datasource": {
          "type": "loki",
          "uid": "${DS_LOKI}"
        },
        "definition": "",
        "hide": 0,
        "includeAll": true,
        "label": "System",
        "multi": true,
        "name": "system",
        "options": [],
        "query": {
          "expr": "sum by (system) (count_over_time({service_name=~\"$service\", deployment_environment=\"$env\"} | json | system!=\"\" [$__range]))",
          "refId": "LokiVariableQueryEditor-VariableQuery",
          "type": 3
        },
        "refresh": 2,
        "regex": "/\"system\"=\"(?<text>[^\"]+)\"/",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      },
      {
