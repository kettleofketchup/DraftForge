        "multi": true,
        "name": "subsystem",
        "options": [],
        "query": {
          "expr": "sum by (subsystem) (count_over_time({service_name=~\"$service\", deployment_environment=\"$env\"} | json | system=~\"$system\" | subsystem!=\"\" [$__range]))",
          "refId": "LokiVariableQueryEditor-VariableQuery",
          "type": 3
        },
        "refresh": 2,
        "regex": "/\"subsystem\"=\"(?<text>[^\"]+)\"/",
        "skipUrlSync": false,
